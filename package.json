{
  "name": "atlas-network-intelligence",
  "version": "0.3.0",
  "private": true,
  "description": "ATLAS — a desktop network intelligence and diagnostics workspace",
  "author": "ATLAS",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "test:desktop": "node scripts/validate-desktop.mjs",
    "test:network": "node scripts/test-network.mjs",
    "package:win": "npm run build && electron-builder --win nsis",
    "test:services": "node scripts/test-services.mjs",
    "test:services-desktop": "node scripts/validate-services-desktop.mjs"
  },
  "build": {
    "appId": "com.atlas.networkintelligence",
    "productName": "ATLAS",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
